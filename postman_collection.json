{
  "info": {
    "name": "Edilcos Automation Backend",
    "_postman_id": "automation-humanaise",
    "description": "Consolidated Postman collection for admin monitoring, webhooks and integrations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.4.5"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "raw_event_id", "value": "" },
    { "key": "tenant_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Shallow Health (admin)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/health", "host": ["{{baseUrl}}"], "path": ["admin","health"] } } },
        { "name": "Deep Health", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/health/deep", "host": ["{{baseUrl}}"], "path": ["admin","health","deep"] } } },
        { "name": "Admin Ready", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/ready", "host": ["{{baseUrl}}"], "path": ["admin","ready"] } } }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        { "name": "Gmail Webhook (PubSub)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"message\": { \"data\": \"<BASE64>\" }\n}"}, "url": { "raw": "{{baseUrl}}/gmail/webhook", "host": ["{{baseUrl}}"], "path": ["gmail","webhook"] } } },
        { "name": "WhatsApp Webhook", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": { "raw": "{{baseUrl}}/whatsapp/webhook", "host": ["{{baseUrl}}"], "path": ["whatsapp","webhook"] } } }
      ]
    },
    {
      "name": "Admin - Monitoring",
      "item": [
        { "name": "Monitoring Overview", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/overview", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","overview"] } } },
        { "name": "Monitoring Stalled", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/stalled?older_than_minutes=15&limit=50", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","stalled"] } } },
        { "name": "Monitoring Errors", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/errors?since_hours=24", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","errors"] } } },
        { "name": "Monitoring Check Alerts", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/admin/monitoring/check-alerts", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","check-alerts"] } } },
        { "name": "Monitoring Raw Events", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/raw_events?limit=50", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","raw_events"] } } },
        { "name": "Monitoring Normalized Events", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/normalized_events?limit=50", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","normalized_events"] } } },
        { "name": "Monitoring Discarded Audits", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/discarded_audits?limit=50", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","discarded_audits"] } } },
        { "name": "Monitoring Audit Trail", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/audit_trail?idempotency_key=", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","audit_trail"] } } },
        { "name": "Monitoring Gmail Events", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/gmail_events?processed=true&limit=50", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","gmail_events"] } } }
      ]
    },
    {
      "name": "Admin - Timeline",
      "item": [
        { "name": "Search Timeline (paginated)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/timeline/search?page=1&per_page=50", "host": ["{{baseUrl}}"], "path": ["admin","timeline","search"] } } }
      ]
    },
    {
      "name": "Admin - Messages",
      "item": [
        { "name": "List Messages", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/messages?limit=50", "host": ["{{baseUrl}}"], "path": ["admin","messages"] } } },
        { "name": "Get Message by ID", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/messages/{{raw_event_id}}", "host": ["{{baseUrl}}"], "path": ["admin","messages","{{raw_event_id}}"] } } }
      ]
    },
    {
      "name": "Admin - Errors",
      "item": [
        { "name": "List Errors", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/errors?limit=50", "host": ["{{baseUrl}}"], "path": ["admin","errors"] } } }
      ]
    },
    {
      "name": "Admin - Tenants",
      "item": [
        { "name": "List Tenants", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/tenants", "host": ["{{baseUrl}}"], "path": ["admin","tenants"] } } },
        { "name": "Get Tenant", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenant_id}}", "host": ["{{baseUrl}}"], "path": ["admin","tenants","{{tenant_id}}"] } } },
        { "name": "Create Tenant", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"name\": \"Acme\",\n  \"file_provider\": null\n}"}, "url": { "raw": "{{baseUrl}}/admin/tenants", "host": ["{{baseUrl}}"], "path": ["admin","tenants"] } } }
      ]
    },
    {
      "name": "Admin - Replay",
      "item": [
        { "name": "Replay RawEvent", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/admin/raw_events/{{raw_event_id}}/replay", "host": ["{{baseUrl}}"], "path": ["admin","raw_events","{{raw_event_id}}","replay"] } } }
      ]
    },
    {
      "name": "Admin - Integrations",
      "item": [
        { "name": "OneDrive Health", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/health/onedrive", "host": ["{{baseUrl}}"], "path": ["admin","health","onedrive"] } } },
        { "name": "List OneDrive Integration Events", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/integrations/onedrive/logs", "host": ["{{baseUrl}}"], "path": ["admin","integrations","onedrive","logs"] } } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        { "name": "Google OAuth Login", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/auth/google/login", "host": ["{{baseUrl}}"], "path": ["auth","google","login"] } } },
        { "name": "Google OAuth Callback (dev)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/auth/google/callback?code=CODE", "host": ["{{baseUrl}}"], "path": ["auth","google","callback"] } } }
      ]
    }
  ]
}
