{
  "info": {
    "name": "Edilcos Automation Backend",
    "_postman_id": "automation-humanaise",
    "description": "Consolidated Postman collection for admin monitoring, webhooks and integrations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.4.4"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "raw_event_id", "value": "" },
    { "key": "tenant_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Shallow Health", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } } },
        { "name": "Deep Health", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health/deep", "host": ["{{baseUrl}}"], "path": ["health","deep"] } } },
        { "name": "Admin Ready", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/ready", "host": ["{{baseUrl}}"], "path": ["admin","ready"] } } }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        { "name": "Gmail Webhook (PubSub)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"message\": { \"data\": \"<BASE64>\" }\n}"}, "url": { "raw": "{{baseUrl}}/gmail/webhook", "host": ["{{baseUrl}}"], "path": ["gmail","webhook"] } } },
        { "name": "WhatsApp Webhook", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": { "raw": "{{baseUrl}}/whatsapp/webhook", "host": ["{{baseUrl}}"], "path": ["whatsapp","webhook"] } } }
      ]
    },
    {
      "name": "Admin - Monitoring",
      "item": [
        { "name": "Monitoring Overview", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/overview", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","overview"] } } },
        { "name": "Monitoring Stalled", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/stalled?older_than_minutes=15&limit=50", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","stalled"] } } },
        { "name": "Monitoring Errors", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/monitoring/errors?since_hours=24", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","errors"] } } },
        { "name": "Monitoring Check Alerts", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/admin/monitoring/check-alerts", "host": ["{{baseUrl}}"], "path": ["admin","monitoring","check-alerts"] } } }
      ]
    },
    {
      "name": "Admin - Messages",
      "item": [
        { "name": "List Messages", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/messages?limit=50", "host": ["{{baseUrl}}"], "path": ["admin","messages"] } } },
        { "name": "Get Message by ID", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/messages/{{raw_event_id}}", "host": ["{{baseUrl}}"], "path": ["admin","messages","{{raw_event_id}}"] } } }
      ]
    },
    {
      "name": "Admin - Integrations",
      "item": [
        { "name": "OneDrive Health", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/health/onedrive", "host": ["{{baseUrl}}"], "path": ["admin","health","onedrive"] } } },
        { "name": "List OneDrive Integration Events", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/integrations/onedrive/logs", "host": ["{{baseUrl}}"], "path": ["admin","integrations","onedrive","logs"] } } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        { "name": "Google OAuth Login", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/auth/google/login", "host": ["{{baseUrl}}"], "path": ["auth","google","login"] } } },
        { "name": "Google OAuth Callback (dev)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/auth/google/callback?code=CODE", "host": ["{{baseUrl}}"], "path": ["auth","google","callback"] } } }
      ]
    }
  ]
}
